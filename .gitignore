# Ignore huge model weights
*.pt
*.nemo
*.ckpt
*.csv

# Ignore raw data if it's huge (optional)
data/raw/

# Ignore python cache
__pycache__/
.ipynb_checkpoints/

# LaTeX auxiliary and generated files
# Keep only source files: .tex, .bib, .cls, .sty, .md
latexcode/*.aux
latexcode/*.bbl
latexcode/*.blg
latexcode/*.log
latexcode/*.out
latexcode/*.synctex.gz
latexcode/*.fdb_latexmk
latexcode/*.fls
latexcode/*.figlist
latexcode/*.makefile
latexcode/*.toc
latexcode/*.lof
latexcode/*.lot
latexcode/*.nav
latexcode/*.snm
latexcode/*.bcf
latexcode/*.run.xml
latexcode/*.xdv
